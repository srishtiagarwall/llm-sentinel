PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llm_sentinel
REDIS_URL=redis://localhost:6379
# Set to true to skip AWS SQS entirely and use a local filesystem queue for
# async trace evaluation — no AWS account or LocalStack needed. eval-service
# must set the same flag (and the same LOCAL_QUEUE_DIR, if overridden) to
# consume from it. Leave unset/false to use real SQS via AWS_SQS_TRACE_QUEUE_URL.
USE_LOCAL_QUEUE=true
LOCAL_QUEUE_DIR=
AWS_SQS_TRACE_QUEUE_URL=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=llm-sentinel-traces
GEMINI_API_KEY=
JWT_SECRET=change_me_in_production
API_SERVICE_URL=http://localhost:3001
# Comma-separated provider names (e.g. "openai" or "openai,gemini") to force
# failing on every call, without touching a real upstream — demonstrates the
# fallback chain and circuit breaker tripping. Leave unset in production.
FORCE_PROVIDER_FAILURE=
